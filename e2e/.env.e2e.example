# Salin ke e2e/.env.e2e. Akun admin dibuat di database UJI dengan: (backend) npm run staff:create:test
E2E_ADMIN_USER=e2e-admin
E2E_ADMIN_PASS=
# Frontend "npm run dev:e2e" (Vite, proxy ke backend uji) dan backend "npm run dev:test"
E2E_BASE_URL=http://localhost:5174
E2E_API_URL=http://localhost:3001/api
# true = Chrome tanpa jendela
E2E_HEADLESS=false
